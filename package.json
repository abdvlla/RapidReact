{
  "name": "rapidreact",
  "displayName": "RapidReact",
  "publisher": "abdvlla",
  "description": "A VS Code extension that adds practical React and TypeScript snippets for components, hooks, forms, utilities, Axios, and TanStack Query.",
  "version": "0.0.1",
  "readme": "MARKETPLACE.md",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "react",
    "typescript",
    "hooks",
    "snippets",
    "axios",
    "tanstack"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/abdvlla/RapidReact.git"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "snippets": [
      {
        "language": "typescriptreact",
        "path": "./snippets/react.code-snippets"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/react-hook-form.code-snippets"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/utils.code-snippets"
      },
      {
        "language": "typescript",
        "path": "./snippets/utils.code-snippets"
      },
      {
        "language": "typescript",
        "path": "./snippets/tanstack/tanstack.code-snippets"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/tanstack/tanstack.code-snippets"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/tanstack/tanstack-pages.code-snippets"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/axios/axios-pages.code-snippets"
      },
      {
        "language": "typescript",
        "path": "./snippets/axios/axios.code-snippets"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/axios/axios.code-snippets"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
